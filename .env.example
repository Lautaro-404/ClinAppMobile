# Copiá este archivo a `.env` (o `.env.dev`, `.env.staging`, `.env.prod`) y completá los valores.
# Uso:
#   flutter run --dart-define-from-file=.env.dev --flavor dev
#   flutter run --dart-define-from-file=.env.staging --flavor staging
#   flutter run --dart-define-from-file=.env.prod --flavor prod
#
# Solo van valores PÚBLICOS. Nunca pongas acá secretos de Mercado Pago ni la
# service_role key de Supabase: esas viven únicamente en las Edge Functions.

# Entorno: dev | staging | prod
ENV=dev

# URL del proyecto Supabase (Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Anon key pública de Supabase (Settings > API)
SUPABASE_ANON_KEY=tu-anon-key-publica

# Esquema y host para retornos de pasarela de pago (Mercado Pago Deep Link)
APP_DEEP_LINK_SCHEME=clinapp
APP_BASE_URL=https://clin.app
