#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Variables de entorno (nunca commitear)
.env
.env.*
!.env.example
!.env.dev.example
!.env.staging.example
!.env.prod.example

# Configuración Firebase (nunca commitear secretos)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Firma de producción Android (nunca commitear keystores ni propiedades)
android/key.properties
**/*.jks
**/*.keystore

# Archivos temporales de Supabase CLI y volcados locales
supabase/.temp/
supabase/.branches/
supabase_schema_parsed.json
